{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openkanji",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets are matched before the Worker runs, so "/" is served from
  // dist without invoking code. Unmatched paths fall through to the Worker,
  // which handles /api/* and otherwise returns the app shell.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  // The report notifier asks GitHub what has happened rather than waiting to be
  // told: a webhook is faster but has to be configured in a place the code
  // cannot reach. Five minutes is soon enough for "someone answered you".
  "triggers": { "crons": ["*/5 * * * *"] },

  // Persisted invocation logs in the dashboard (free tier). Every fetch and
  // every cron tick leaves a record there, which is how a cron that quietly
  // stops firing -- it happened -- gets noticed without a terminal tail.
  "observability": { "logs": { "enabled": true, "invocation_logs": true } },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openkanji",
      "database_id": "fc1b3683-bb40-41f0-8b76-eae69f58b0d4"
    }
  ],

  // Secrets (RESEND_API_KEY, SESSION_SECRET, DEEPSEEK_API_KEY, GITHUB_TOKEN,
  // OWNER_EMAIL) are set with `wrangler secret put` and never live in this
  // file. OWNER_EMAIL is who the AI-error digest cron mails; without it the
  // digest still runs (and still prunes ai_errors) but has nowhere to send.
  "vars": {
    // Nothing reads mail at openkanji.org, so the address says so rather than
    // inviting a reply that bounces. Every mail that wants an answer points at
    // the place the answer belongs.
    "MAIL_FROM": "OpenKanji <noreply@openkanji.org>",
    "SITE_URL": "https://openkanji.org",
    // Where the in-app report form opens its issues. Without GITHUB_TOKEN set
    // as a secret the form says so and offers GitHub itself instead.
    "ISSUE_REPO": "nickgreengithub/openkanji",
    // The model behind Write and the IME, and each account's calls per hour.
    "AI_MODEL": "deepseek-v4-flash",
    "AI_PER_HOUR": "150"
  }
}
