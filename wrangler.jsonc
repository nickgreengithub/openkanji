{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openkanji",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-09-02",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openkanji",
      "database_id": "fc1b3683-bb40-41f0-8b76-eae69f58b0d4"
    }
  ],
  "vars": {
    // Sending address. Secrets (RESEND_API_KEY, SESSION_SECRET) are set with
    // `wrangler pages secret put` and never live in this file.
    "MAIL_FROM": "OpenKanji <nick@openkanji.org>"
  }
}
